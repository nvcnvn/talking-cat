# ---- LLM (GLM 5.2, OpenAI-compatible endpoint) ----
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace-me
LLM_MODEL=glm-5.2

# ---- Speech to text (faster-whisper, CPU) ----
STT_PROVIDER=whisper         # whisper = faster-whisper (Linux CPU/CUDA, Docker) | mlx_whisper (Mac, native) | fake
WHISPER_MODEL=small          # tiny | base | small | medium (small is a good CPU trade-off for Vietnamese)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_MIN_CONFIDENCE=0.55       # below this the transcript is treated as several kids talking at once; 0 disables
MLX_WHISPER_MODEL=mlx-community/whisper-small-mlx   # Mac only; mlx-community/whisper-large-v3-turbo is better and still fast on M-series

# ---- Text to speech ----
TTS_PROVIDER=edge            # edge (Microsoft neural, nicest voice) | piper (self-hosted) | fake
TTS_FALLBACK=piper           # used when the primary errors or exceeds TTS_DEADLINE_S; piper | fake | none
TTS_DEADLINE_S=2.5
TTS_VOICE=vi-VN-HoaiMyNeural # or vi-VN-NamMinhNeural
TTS_RATE=-5%
PIPER_VOICE=vi_VN-vais1000-medium

# ---- Safety ----
SAFETY_LLM_CHECK=true        # rules always run; this adds an LLM classifier on the child's input (concurrent with generation)
SAFETY_LLM_CHECK_OUTPUT=false # also classify the cat's reply with the LLM (adds one round-trip)

# ---- Web ----
WEB_PORT=8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
